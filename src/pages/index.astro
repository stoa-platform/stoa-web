---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import WhyNow from '../components/WhyNow.astro';
import SocialProof from '../components/SocialProof.astro';
import Divider from '../components/Divider.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import TTFAC from '../components/TTFAC.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import Scenario from '../components/Scenario.astro';
import Differentiators from '../components/Differentiators.astro';
import Company from '../components/Company.astro';
import Metrics from '../components/Metrics.astro';
import Standards from '../components/Standards.astro';
import Pricing from '../components/Pricing.astro';
import PricingFAQ from '../components/PricingFAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout
  title={t('site.title')}
  description={t('site.description')}
  structuredDataType="SoftwareApplication"
>
  <Header />
  <main>
    <Hero />
    <Divider color="teal" />
    <WhyNow />
    <SocialProof />
    <Divider color="purple" />
    <BeforeAfter />
    <Divider color="purple" />
    <TTFAC />
    <Divider color="blue" />
    <Features />
    <Divider color="orange" />
    <Architecture />
    <Divider color="green" />
    <Scenario />
    <Differentiators />
    <Company />
    <Metrics />
    <Standards />
    <Pricing />
    <PricingFAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
