---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Pricing from '../components/Pricing.astro';
import PricingFAQ from '../components/PricingFAQ.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<Layout
  title={t('pricing.page.title')}
  description="STOA is free and open source under Apache 2.0. Self-host the full platform forever. Enterprise and Sovereign plans available for regulated industries."
>
  <Header />
  <main style="padding-top: 80px;">
    <Pricing />
    <PricingFAQ />
  </main>
  <Footer />
</Layout>
