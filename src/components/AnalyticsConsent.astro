---
interface Props { lang: 'en' | 'fr'; }
const { lang } = Astro.props;
const fr = lang === 'fr';
const text = fr ? {
  title: 'Cookies et confidentialité',
  detail: 'Avec votre accord, nous utilisons des cookies pour mesurer les visites et comprendre la navigation afin d’améliorer le site.',
  more: 'Google Analytics mesure les visites. Microsoft Clarity reconstitue les parcours de navigation sous forme de replays, avec les saisies masquées ou exclues. Sans accord, ces deux services restent désactivés.',
  refuse: 'Refuser', accept: 'Accepter', settings: 'Cookies', revoke: 'Retirer mon accord de mesure d’audience',
  moreLabel: 'En savoir plus', policy: 'Politique de confidentialité', duration: 'Votre choix est conservé six mois sur ce navigateur. Vous pouvez le modifier ou retirer votre accord à tout moment avec le bouton Cookies.',
} : {
  title: 'Cookies and privacy',
  detail: 'With your permission, we use cookies to measure visits and understand navigation so we can improve the site.',
  more: 'Google Analytics measures visits. Microsoft Clarity reconstructs browsing activity as session replays, with form entry masked or excluded. Without permission, both services stay disabled.',
  refuse: 'Refuse', accept: 'Accept', settings: 'Cookies', revoke: 'Withdraw audience-measurement consent',
  moreLabel: 'Learn more', policy: 'Privacy policy', duration: 'Your choice is kept for six months in this browser. You can change or withdraw your consent at any time using the Cookies button.',
};
---
<div data-analytics-consent-root>
  <section class="consent-panel" id="analytics-consent" data-consent-panel aria-labelledby="analytics-consent-title" hidden>
    <h2 id="analytics-consent-title"><img src="/favicon.svg" alt="" width="18" height="18" aria-hidden="true" />{text.title}</h2>
    <p>{text.detail}</p>
    <div class="consent-actions">
      <button type="button" data-consent-refuse>{text.refuse}</button>
      <button type="button" data-consent-accept>{text.accept}</button>
    </div>
    <details class="consent-details">
      <summary>{text.moreLabel}</summary>
      <p>{text.more}</p>
      <p>{text.duration}</p>
      <a href={fr ? '/fr/privacy/' : '/privacy/'}>{text.policy}</a>
    </details>
  </section>
  <div class="consent-tools">
    <button type="button" data-consent-settings aria-controls="analytics-consent" aria-expanded="false">{text.settings}</button>
    <button type="button" data-consent-revoke hidden>{text.revoke}</button>
  </div>
</div>
<script>
  import { mountAnalyticsConsent } from '../scripts/analytics-consent.js';
  mountAnalyticsConsent();
</script>
<style>
  .consent-panel { position:fixed; z-index:10000; bottom:56px; left:16px; width:min(420px,calc(100% - 32px)); max-height:calc(100dvh - 88px); overflow:auto; border:1px solid var(--line,#35423e); border-radius:10px; background:var(--panel,var(--bg-elevated,#14221c)); color:var(--ink,var(--text-primary,#e9f1ed)); padding:18px; box-shadow:0 4px 18px #0003; font:13px/1.55 system-ui,sans-serif; }
  .consent-panel[hidden], .consent-tools [hidden] { display:none; }
  .consent-panel h2 { display:flex; align-items:center; gap:8px; font-size:15px; line-height:1.4; font-weight:650; letter-spacing:normal; margin:0 0 8px; color:inherit; }
  .consent-panel h2 img { flex:none; }
  .consent-panel p { margin:0; }
  .consent-panel a { color:inherit; text-decoration:underline; text-underline-offset:3px; }
  .consent-actions { display:flex; gap:10px; margin:14px 0 11px; }
  .consent-actions button { flex:1; min-height:40px; padding:8px 14px; border:1px solid #70877b; border-radius:6px; background:transparent; color:inherit; font:600 13px/1.5 system-ui,sans-serif; cursor:pointer; }
  .consent-actions button:hover { background:#ffffff0c; border-color:#adc4b6; }
  .consent-details { font-size:12px; color:var(--soft,var(--text-secondary,#b5c4bc)); }
  .consent-details summary { width:fit-content; cursor:pointer; color:inherit; }
  .consent-details p { margin-top:10px; }
  .consent-details a { display:inline-block; margin-top:10px; }
  .consent-tools { display:flex; flex-wrap:wrap; gap:6px; position:fixed; z-index:9999; bottom:12px; left:12px; max-width:calc(100% - 24px); }
  .consent-tools button { border:1px solid var(--line,#35423e); border-radius:6px; background:var(--panel,var(--bg-elevated,#14221c)); color:var(--ink,var(--text-primary,#e9f1ed)); padding:6px 9px; font:11px/1.5 system-ui,sans-serif; cursor:pointer; }
  .consent-panel button:focus-visible, .consent-panel a:focus-visible, .consent-panel summary:focus-visible, .consent-tools button:focus-visible { outline:2px solid #a7efc4; outline-offset:3px; }
  @media (max-width:480px) { .consent-panel { left:12px; width:calc(100% - 24px); padding:16px; bottom:56px; } .consent-tools { gap:4px; } }
</style>
