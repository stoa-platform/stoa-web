---
// Small local stroke icons; no icon font or runtime dependency.
interface Props { name: string; small?: boolean; }
const { name, small = false } = Astro.props;
const paths: Record<string, string> = {
  check: 'm5 12 4 4 10-10',
  'arrow-right': 'M5 12h14m-7-7 7 7-7 7',
  'arrow-up-right': 'M7 7h10v10M7 17 17 7',
  'chevron-down': 'm6 9 6 6 6-6',
  menu: 'M4 6h16M4 12h16M4 18h16',
  moon: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z',
  sun: 'M12 2v2m0 16v2M2 12h2m16 0h2m-15-13 1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5',
  'file-code': 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8ZM14 2v6h6m-10 5-2 2 2 2m4-4 2 2-2 2',
  'shield-check': 'M12 3 4 6v7c0 4 3 7 8 9 5-2 8-5 8-9V6ZM9 12l2 2 4-4',
  'git-branch': 'M6 3v12m12-6a9 9 0 0 1-9 9',
  'flask-conical': 'M10 2v8L5 20a1 1 0 0 0 1 2h12a1 1 0 0 0 1-2l-5-10V2M8 2h8M7 16h10',
};
---
<svg class:list={['icon', { 'icon--sm': small }]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={paths[name] || paths.check} />
  {name === 'sun' && <circle cx="12" cy="12" r="4" />}
  {name === 'git-branch' && <><circle cx="6" cy="18" r="3" /><circle cx="18" cy="6" r="3" /></>}
</svg>
