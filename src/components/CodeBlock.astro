---
import { Code } from 'astro:components';
import { useTranslations, type Lang } from '../i18n/utils';
interface Props { id: string; title: string; code: string; lang: Lang; syntax?: string; note: string; }
const { id, title, code, lang, syntax = 'yaml', note } = Astro.props;
const t = useTranslations(lang);
---
<figure class="code" aria-labelledby={`${id}-caption`}>
  <figcaption class="code__bar" id={`${id}-caption`}><span>{title}</span><button class="code__copy" type="button" data-copy={id} data-copied={t('code.copied')} data-error={t('code.error')} hidden><span aria-live="polite">{t('code.copy')}</span></button></figcaption>
  <div id={id}><Code code={code} lang={syntax} theme="css-variables" tabindex="0" aria-label={title} /></div>
  <p class="code__note">{note}</p>
</figure>
