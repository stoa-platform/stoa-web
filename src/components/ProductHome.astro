---
import { productHome, productHomeLinks as links, type ProductHomeLocale } from '../i18n/product-home';
interface Props { lang: ProductHomeLocale; }
const { lang } = Astro.props;
const t = productHome[lang];
const firstView = t.preview.views[0];
const languageHref = lang === 'fr' ? '/' : '/fr/';
const languageLabel = lang === 'fr' ? 'Switch to English' : 'Passer en français';
---
<a class="skip-link" href="#main">{lang === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
<header class="header"><div class="wrap nav">
  <a class="logo" href="#accueil" aria-label={t.nav.logoLabel}><img src="/favicon.svg" alt="" width="32" height="32" /><span>STOA</span></a>
  <nav class="nav-links" id="navigation" aria-label={t.nav.label}><a href="#produit">{t.nav.product}</a><a href="#fonctionnalites">{t.nav.features}</a><a href="#architecture">{t.nav.architecture}</a><a href="#ressources">{t.nav.resources}</a><a class="nav-doc-mobile" href={links.docs}>{t.nav.docs} ↗</a></nav>
  <div class="nav-right"><a class="nav-source" href={links.github} target="_blank" rel="noopener noreferrer">{t.nav.github} ↗</a><a class="language-link" href={languageHref} aria-label={languageLabel}>{lang === 'fr' ? 'EN' : 'FR'}</a><a class="button small" href={links.docs}>{t.nav.docs} ↗</a><button class="menu-button" aria-expanded="false" aria-controls="navigation">{t.nav.menu} ☰</button></div>
</div></header>
<main id="main">
  <section class="hero" id="accueil"><div class="wrap"><div class="hero-copy"><div class="hero-label">{t.hero.label}</div><h1>{t.hero.title[0]}<br /><span>{t.hero.title[1]}</span></h1><p class="hero-lead">{t.hero.lead[0]}<br />{t.hero.lead[1]}</p><div class="hero-actions"><a class="button" href="#produit">{t.hero.explore}<span aria-hidden="true">↓</span></a><a class="button secondary" href={links.quickstart}>{t.hero.start}<span aria-hidden="true">↗</span></a></div><p class="hero-caption">{t.hero.caption}</p></div>
  <div class="preview-label" id="produit"><span>{t.preview.label}</span><small>{t.preview.eyebrow}</small></div>
  <div class="product-preview"><div class="preview-chrome"><div class="window-dots" aria-hidden="true"><i></i><i></i><i></i><span>{t.preview.consoleTitle}</span></div><div class="screen-tabs" role="tablist" aria-label={t.preview.tablistLabel}>{t.preview.views.map((view,index)=><button role="tab" id={`tab-${view.key}`} aria-selected={index===0?'true':'false'} aria-controls="screen-panel" tabindex={index===0?0:-1} data-image={`/product/${view.source}`} data-alt={view.alt} data-caption={view.caption}>{view.label}</button>)}</div></div><div id="screen-panel" role="tabpanel" aria-labelledby={`tab-${firstView.key}`}><div class="screenshot-frame"><img id="product-screen" src={`/product/${firstView.source}`} width="1440" height="900" alt={firstView.alt} loading="eager" decoding="async" /></div><div class="screen-bottom"><p id="screen-caption" aria-live="polite">{firstView.caption}</p><button class="zoom-button" id="zoom-screen">{t.preview.enlarge} ↗</button></div></div></div>
  </div></section>
  <section class="platform" id="fonctionnalites"><div class="wrap"><div class="section-intro"><div><div class="eyebrow">{t.features.eyebrow}</div><h2>{t.features.title[0]}<br />{t.features.title[1]}</h2></div><p>{t.features.description}</p></div><div class="feature-grid">{t.features.items.map((item,index)=><article class:list={['feature',{primary:index===0}]}>
    <div class:list={['feature-graphic',{trace:index===2}]} aria-hidden="true">{index===0?<div class="mini-stack"><i></i><i></i><i></i></div>:index===1?<div class="gate-graphic"><i></i><span></span><i></i><span></span><i></i></div>:<div class="trace-graphic"><i></i><i></i><i></i><i></i><i></i><i></i></div>}</div>
    <h3>{item.title[0]}<br />{item.title[1]}</h3><p>{item.description}</p><details><summary>{item.detailsLabel}</summary><p>{item.details}</p></details>
  </article>)}</div></div></section>
  <section class="architecture" id="architecture"><div class="wrap arch-grid"><div class="arch-copy"><div class="eyebrow">{t.architecture.eyebrow}</div><h2>{t.architecture.title[0]}<br />{t.architecture.title[1]}</h2><p>{t.architecture.description}</p><a class="text-link" href={links.architecture}>{t.architecture.link}<span aria-hidden="true">↗</span></a></div><div class="arch-visual" role="img" aria-label={t.architecture.diagram.label}><div class="diagram-tag">{t.architecture.diagram.tag}</div><div class="control-plane"><b>{t.architecture.diagram.controlPlane}</b><small>{t.architecture.diagram.controlPlaneDetail}</small></div><div class="data-flow"><div class="data-node">{t.architecture.diagram.consumers}<small>{t.architecture.diagram.consumersDetail}</small></div><span aria-hidden="true">→</span><div class="data-node current">{t.architecture.diagram.gateway}<small>{t.architecture.diagram.gatewayDetail}</small></div><span aria-hidden="true">→</span><div class="data-node">{t.architecture.diagram.services}<small>{t.architecture.diagram.servicesDetail}</small></div></div><div class="diagram-caption">{t.architecture.diagram.caption}</div></div></div></section>
  <section class="resources" id="ressources"><div class="wrap"><div class="resource-header"><div class="eyebrow">{t.resources.eyebrow}</div><h2>{t.resources.title[0]}<br />{t.resources.title[1]}</h2><p>{t.resources.description}</p></div><nav class="docs-paths" aria-label={t.documentationPaths.label}><a href={links.quickstart}>{t.documentationPaths.guide}</a><a href={links.architecture}>{t.documentationPaths.architecture}</a><a href={links.apiReference}>{t.documentationPaths.apiReference}</a></nav><div class="resources-grid">{t.resources.items.map(item=><a class="resource" href={item.href}><span class="tag">{item.tag}</span><h3>{item.title}<span aria-hidden="true">↗</span></h3><p>{item.description}</p></a>)}</div></div></section>
</main>
<footer class="footer"><div class="wrap"><div class="footer-top"><div><a class="logo" href="#accueil"><img src="/favicon.svg" width="30" height="30" alt="" /><span>STOA</span></a><p>{t.footer.tagline}</p></div><div class="footer-links"><a href="#produit">{t.footer.product}</a><a href={links.docs}>{t.footer.docs} ↗</a><a href={links.github} target="_blank" rel="noopener noreferrer">{t.footer.github} ↗</a></div></div><div class="footer-bottom"><div>© {new Date().getFullYear()} STOA · CAB Ingénierie</div><div class="related"><a href={links.cab}>{t.footer.cab.label}<span> · {t.footer.cab.description} ↗</span></a><a href={links.labs}>{t.footer.labs.label}<span> · {t.footer.labs.description} ↗</span></a></div></div></div></footer>
<dialog class="image-dialog" id="image-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><span id="dialog-title">{t.preview.dialogTitle}</span><button class="dialog-close" autofocus>{t.preview.close} ×</button></div><div class="zoom-scroll"><img id="large-screen" alt="" /></div></dialog>
<script>import '../scripts/product-home';</script>
