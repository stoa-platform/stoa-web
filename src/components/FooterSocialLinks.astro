---
import type { Lang } from '../i18n/utils';
import { SOCIAL_LINKS } from '../scripts/social-links.js';

interface Props { lang: Lang }
const { lang } = Astro.props;
// Local marks from LinkedIn Brand Downloads and the X Brand Toolkit.
---

<nav class="footer-social" aria-label={lang === 'fr' ? 'Réseaux sociaux' : 'Social media'}>
  <ul>
    {SOCIAL_LINKS.map(({ href, label, category }) => (
      <li>
        <a href={href} aria-label={label} title={label}>
          <img src={category === 'x_profile' ? '/social/x.svg' : '/social/linkedin.png'} alt="" width="24" height="24" />
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .footer-social {
    margin-top: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.footer-v4) ul {
    justify-content: center;
  }

  a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid #b4cbb24d;
    border-radius: 7px;
    color: #e4eee5;
    background: #15241e;
  }

  a:hover {
    border-color: #b4cbb2;
    background: #21362b;
  }

  img {
    display: block;
    object-fit: contain;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .footer-social {
      padding-bottom: 1.25rem;
    }
  }
</style>
