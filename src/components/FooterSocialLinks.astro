---
import type { Lang } from '../i18n/utils';
import { SOCIAL_LINKS } from '../scripts/social-links.js';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<nav class="footer-social" aria-label={lang === 'fr' ? 'Réseaux sociaux' : 'Social media'}>
  <ul>
    {SOCIAL_LINKS.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
  </ul>
</nav>

<style>
  .footer-social {
    margin-top: 1rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :global(.footer-v4) ul {
    justify-content: center;
  }

  a {
    display: inline-block;
    padding-block: 0.375rem;
    color: #b4cbb2;
    font-size: 0.8125rem;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: #e4eee5;
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .footer-social {
      padding-bottom: 1.25rem;
    }
  }
</style>
