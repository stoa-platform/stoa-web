---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { Content as TutorialEn } from '../content/tutorials/en/expose-rest-as-mcp.md';
import { Content as TutorialFr } from '../content/tutorials/fr/expose-rest-as-mcp.md';
import { getLangFromUrl, getLocalizedHref } from '../i18n/utils';
import { tutorial, videoFiles } from '../data/rest-mcp-tutorial';

const lang = getLangFromUrl(Astro.url);
const t = tutorial(lang, Astro.site!);
const Content = lang === 'fr' ? TutorialFr : TutorialEn;
const videoJson = JSON.stringify(t.schema).replace(/</g, '\\u003c');
---

<Layout title={t.title} description={t.description}>
  <script slot="head" type="application/ld+json" is:inline set:html={videoJson}></script>
  <a class="tutorial-skip" href="#tutorial-main">{t.skip}</a>
  <Header featuresHref={getLocalizedHref(lang, '/#fonctionnalites')} />
  <main id="tutorial-main" class="tutorial">
    <article>
      <h1>{t.title}</h1>
      <p class="intro">{t.intro}</p>
      <p class="tutorial-jump"><a href="#sovereignty">{t.sovereignty}</a></p>


      <section aria-labelledby="tutorial-video">
        <h2 id="tutorial-video">{t.videoTitle}</h2>
        <figure>
          <div class="video-frame">
            <video
              controls playsinline preload="none"
              poster={videoFiles.poster}
              width={videoFiles.width} height={videoFiles.height}
              aria-label={t.videoTitle} aria-describedby="tutorial-video-summary"
            >
              <source src={videoFiles.source} type="video/mp4" />
              <track kind="captions" src={videoFiles.captions.en} srclang="en" label="English" default={lang === 'en'} />
              <track kind="captions" src={videoFiles.captions.fr} srclang="fr" label="Français" default={lang === 'fr'} />
              <a href={videoFiles.source}>{t.download}</a>
            </video>
            <button type="button" class="play" data-tutorial-play hidden>
              <span aria-hidden="true">▶</span>
              {t.play}
            </button>
          </div>
          <figcaption id="tutorial-video-summary">{t.videoDescription}</figcaption>
        </figure>
      </section>

      <div class="tutorial-body">
        <Content />
        <p><a href={t.learnHref} hreflang={lang}>{t.learn}</a></p>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<script>
  const play = document.querySelector<HTMLButtonElement>('[data-tutorial-play]');
  const video = play?.parentElement?.querySelector('video');

  if (play && video) {
    video.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => {
      const language = document.documentElement.lang;
      video.addEventListener('playing', () => {
        for (const track of video.textTracks) {
          track.mode = track.language === language ? 'showing' : 'disabled';
        }
      }, { once: true });
      play.hidden = true;
      video.controls = true;
      void video.play().catch(() => {
        // Leave the native controls available to retry playback.
      });
      video.focus({ preventScroll: true });
    }, { once: true });
  }
</script>

<style>
  .tutorial {
    width: min(100%, 59rem);
    margin: 0 auto;
    padding: calc(64px + clamp(1.75rem, 5vw, 3.5rem)) clamp(1rem, 4vw, 2rem) clamp(3rem, 7vw, 5rem);
    color: var(--text-primary, #f0f4f3);
    font-size: 1.06rem;
    line-height: 1.65;
  }

  .tutorial-skip {
    position: fixed;
    z-index: 2000;
    top: .5rem;
    left: .5rem;
    transform: translateY(-150%);
    padding: .5rem 1rem;
    color: #fff;
    background: #16372b;
    border-radius: .4rem;
  }

  .tutorial-skip:focus { transform: translateY(0); }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.12; text-wrap: balance; }
  .intro { margin-top: 1.1rem; font-size: clamp(1.1rem, 2vw, 1.25rem); }
  h2, .tutorial-body :global(h2) {
    margin: 2.15rem 0 .8rem;
    font-size: clamp(1.32rem, 3vw, 1.8rem);
    font-weight: 650;
    line-height: 1.25;
    scroll-margin-top: 5rem;
  }

  .tutorial-jump { margin-top: .75rem; }
  .tutorial-jump a, .tutorial-body :global(a) {
    color: #86efac;
    text-decoration: underline;
    text-underline-offset: .16em;
    overflow-wrap: anywhere;
  }
  figure { margin: 0; }
  .video-frame { position: relative; max-width: 45rem; }
  video {
    width: 100%;
    height: auto;
    aspect-ratio: 10 / 7;
    display: block;
    background: #101822;
    border: 1px solid #2c5447;
    border-radius: .9rem;
  }

  .play:not([hidden]) {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 44px;
    padding: .6rem 1rem;
    background: #163c2e;
    color: #fff;
    border: 1px solid #8fd5b8;
    border-radius: 2rem;
    font-weight: 650;
    white-space: nowrap;
    cursor: pointer;
  }

  .play:hover { background: #204f3d; }
  .play:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  figcaption { margin-top: .7rem; max-width: 45rem; color: var(--text-secondary, #b6c3c1); }
  .tutorial-body :global(p), .tutorial-body :global(ul) { margin-block: .75rem; }
  .tutorial-body :global(ul) { list-style: disc; padding-inline-start: 1.4rem; }
  .tutorial-body :global(li + li) { margin-top: .3rem; }
  .tutorial-body :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    margin-block: 1rem;
    padding: .85rem 1rem;
    border: 1px solid #30443d;
    border-radius: .6rem;
    background: #182228;
    font-size: .85rem;
    line-height: 1.6;
  }
  .tutorial-body :global(code) { font-size: .9em; }
  .tutorial-body :global(table) { width: 100%; border-collapse: collapse; margin-block: 1rem; font-size: .95rem; }
  .tutorial-body :global(th), .tutorial-body :global(td) {
    border: 1px solid #30443d;
    padding: .4rem .5rem;
    text-align: start;
    overflow-wrap: anywhere;
  }
  .tutorial-body :global(th) { background: #17382f; overflow-wrap: normal; }
</style>
