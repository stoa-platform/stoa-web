---
import { getLangFromUrl, useTranslations, getAlternateUrl } from '../i18n/utils';
interface Props { title?: string; description?: string; noindex?: boolean; }
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('seo.defaultTitle'), description = t('seo.defaultDescription'), noindex = false } = Astro.props;
const site = Astro.site!.href;
const canonical = new URL(getAlternateUrl(Astro.url, lang), site).href;
const en = new URL(getAlternateUrl(Astro.url, 'en'), site).href;
const fr = new URL(getAlternateUrl(Astro.url, 'fr'), site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="CAB Ingénierie — France" />
<link rel="canonical" href={canonical} />
{!noindex && <>
  <link rel="alternate" hreflang="en" href={en} />
  <link rel="alternate" hreflang="fr" href={fr} />
  <link rel="alternate" hreflang="x-default" href={en} />
</>}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="STOA" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
<meta property="og:locale:alternate" content={lang === 'fr' ? 'en_US' : 'fr_FR'} />
<meta property="og:image" content={new URL('/og-image.png', site).href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="STOA" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL('/og-image.png', site).href} />
