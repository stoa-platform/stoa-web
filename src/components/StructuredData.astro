---
import { faqKeys } from '../data/faq';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const hasFaq = /^\/(?:fr\/)?(?:pricing\/)?$/.test(Astro.url.pathname);
const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization', '@id': 'https://www.gostoa.dev/#publisher',
      name: 'CAB Ingénierie — France', brand: { '@type': 'Brand', name: 'STOA' },
      url: 'https://www.gostoa.dev', logo: 'https://www.gostoa.dev/favicon.svg',
      email: 'contact@gostoa.dev',
      sameAs: ['https://github.com/stoa-platform', 'https://labs.gostoa.dev', 'https://discord.gostoa.dev'],
    },
    {
      '@type': 'WebSite', '@id': 'https://www.gostoa.dev/#website',
      name: 'STOA', url: 'https://www.gostoa.dev', inLanguage: ['en', 'fr'],
      description: t('seo.defaultDescription'), publisher: { '@id': 'https://www.gostoa.dev/#publisher' },
    },
    ...(hasFaq ? [{
      '@type': 'FAQPage', inLanguage: lang,
      mainEntity: faqKeys.map(key => ({
        '@type': 'Question', name: t(`faq.${key}.q`),
        acceptedAnswer: { '@type': 'Answer', text: `${key === 'scope' ? `${t('license')} ` : ''}${t(`faq.${key}.a`)}` },
      })),
    }] : []),
  ],
};
---
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
