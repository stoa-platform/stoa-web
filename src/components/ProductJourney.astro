---
import { productJourney, type JourneyLocale } from '../i18n/product-journey';
interface Props { lang: JourneyLocale }
const {lang} = Astro.props;
const c = productJourney[lang];
const t = c.journey;
---
<section class="journey motion-reveal" id="produit" data-journey data-play-label={t.play} data-pause-label={t.pause} data-replay-label={t.replay} data-allowed-action={c.request.allowedAction} data-blocked-action={c.request.blockedAction} data-allowed-result={c.request.allowedResult} data-blocked-result={c.request.blockedResult} data-allowed-detail={c.request.allowedDetail} data-blocked-detail={c.request.blockedDetail}>
  <div class="wrap">
    <div class="journey-heading"><div><p class="eyebrow">{t.eyebrow}</p><h2>{t.title[0]}<br/><span>{t.title[1]}</span></h2></div><p>{t.description}</p></div>
    <div class="journey-shell">
      <div class="journey-tabs" role="tablist" aria-label={t.tablist}>{t.steps.map((step,index)=><button class="journey-tab" role="tab" id={`journey-tab-${step.key}`} aria-selected={index===0?'true':'false'} aria-controls={`journey-panel-${step.key}`} tabindex={index===0?0:-1} data-step={index}><span class="step-number">0{index+1}</span><span>{step.label}</span><span class="step-arrow" aria-hidden="true">↗</span><span class="step-progress" aria-hidden="true"></span></button>)}</div>
      {t.steps.map((step,index)=><div class="journey-panel" id={`journey-panel-${step.key}`} role="tabpanel" aria-labelledby={`journey-tab-${step.key}`} tabindex="0" hidden={index!==0}>
        <div class="journey-story"><p class="journey-kicker">{step.kicker}</p><h3>{step.title}</h3><p class="journey-description">{step.description}</p><div class="journey-benefit"><span aria-hidden="true">↳</span><p>{step.detail}</p></div><div class="journey-checklist"><strong>{step.bulletTitle}</strong>{step.bullets.map(bullet=><div><span aria-hidden="true">✓</span>{bullet}</div>)}</div></div>
        <div class={`journey-visual journey-visual-${step.key}`}>
          <div class="journey-visual-bar"><span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>{step.visualLabel}</span><span class="visual-status" aria-hidden="true">0{index+1} / 04</span></div>
          {index===0 ? <div class="customer-problem"><div class="assistant-card"><span class="assistant-icon" aria-hidden="true">✳</span><div><strong>{c.request.actorValue}</strong><p>{c.request.allowedAction}</p></div></div><div class="problem-connection" aria-hidden="true"></div><div class="broad-access"><span class="key-mark" aria-hidden="true">⌘</span><strong>{lang==='fr'?'Une clé partagée, trop de droits':'One shared key, too many permissions'}</strong><span class="risk-badge">{lang==='fr'?'Accès trop large':'Overly broad access'}</span></div><div class="risk-options"><div><span aria-hidden="true">↳</span>{c.request.allowedAction}</div><div class="risk-unneeded"><span aria-hidden="true">!</span>{c.request.blockedAction}</div><div class="risk-unneeded"><span aria-hidden="true">!</span>{lang==='fr'?'Accéder aux autres données':'Access other data'}</div></div><p class="problem-question">{lang==='fr'?'Comment lui donner le nécessaire, sans ouvrir le reste ?':'How do you give it what it needs without opening everything else?'}</p></div> : index===1 ? <div class="policy-demo"><div class="policy-heading"><span class="policy-icon" aria-hidden="true">◇</span><div><h4>{c.policy.title}</h4><p>{c.policy.subtitle}</p></div></div><dl><div><dt>{c.policy.identity}</dt><dd>{c.policy.identityValue}</dd></div><div><dt>{c.policy.resource}</dt><dd>{c.policy.resourceValue}</dd></div><div><dt>{c.policy.scope}</dt><dd><span class="scope-chip">{c.policy.scopeValue}</span></dd></div></dl><div class="policy-checks">{c.policy.checks.map((check,i)=><div><span class="policy-check-number">0{i+1}</span><span>{check}</span><span class="policy-tick" aria-hidden="true">✓</span></div>)}</div><div class="policy-decision"><span aria-hidden="true">✓</span>{c.policy.decision}</div></div> : index===2 ? <div class="customer-control"><div class="request-heading"><h4>{c.request.title}</h4><p>{c.request.subtitle}</p></div><div class="request-choices" role="group" aria-label={c.request.requestLabel}><button type="button" data-request-case="allowed" aria-pressed="true"><span aria-hidden="true">↗</span>{c.request.allowedAction}</button><button type="button" data-request-case="blocked" aria-pressed="false"><span aria-hidden="true">✎</span>{c.request.blockedAction}</button></div><div class="customer-outcome" role="status"><span class="outcome-symbol" aria-hidden="true"></span><div><span class="outcome-label">{c.request.decisionLabel}</span><h4 data-example-result>{c.request.allowedResult}</h4><p data-example-detail>{c.request.allowedDetail}</p></div></div><p class="request-note">{c.request.note}</p></div> : <div class="customer-trace"><div class="trace-header"><span class="trace-icon" aria-hidden="true">≡</span><div><h4>{c.request.traceLabel}</h4><p>{lang==='fr'?'L’accès s’explique, il ne se devine plus.':'Access can be explained, not guessed.'}</p></div></div><div class="trace-record"><div><span>{c.request.actorLabel}</span><strong>{c.request.actorValue}</strong></div><div><span>{c.request.actionLabel}</span><strong data-example-action>{c.request.allowedAction}</strong></div><div class="trace-verdict"><span>{c.request.resultLabel}</span><strong data-example-result>{c.request.allowedResult}</strong></div></div><ol class="trace-timeline">{c.request.traceSteps.map((line,i)=><li><span aria-hidden="true">0{i+1}</span>{line}<b aria-hidden="true">✓</b></li>)}</ol></div>}
        </div>
      </div>)}
      <div class="journey-controls"><p><span>{t.progressLabel}</span><span class="journey-counter" aria-live="polite"><span data-current-step>01</span><span> / </span>04</span></p><button class="journey-play" type="button"><span class="play-symbol" aria-hidden="true">▶</span><span class="play-text">{t.play}</span></button></div>
    </div>
    <p class="journey-notice">{t.notice}</p>
  </div>
</section>
