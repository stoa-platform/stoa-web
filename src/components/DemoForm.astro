---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sidebarItems = [
  t('demo.sidebar.item1'),
  t('demo.sidebar.item2'),
  t('demo.sidebar.item3'),
  t('demo.sidebar.item4'),
];
---

<section class="demo-section" aria-label="Book a demo">
  <div class="section-container">
    <div class="demo-grid">
      <div class="demo-form-col">
        <h1 class="demo-heading reveal" data-reveal>{t('demo.heading')}</h1>
        <p class="demo-subtitle reveal" data-reveal data-reveal-delay="100">{t('demo.subtitle')}</p>

        <form id="demo-form" class="demo-form reveal" data-reveal data-reveal-delay="200" data-clarity-mask="true">
          <div class="form-row">
            <div class="form-group">
              <label for="demo-name">{t('demo.form.name')}</label>
              <input type="text" id="demo-name" name="name" required autocomplete="name" />
            </div>
            <div class="form-group">
              <label for="demo-email">{t('demo.form.email')}</label>
              <input type="email" id="demo-email" name="email" required autocomplete="email" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="demo-company">{t('demo.form.company')}</label>
              <input type="text" id="demo-company" name="company" required autocomplete="organization" />
            </div>
            <div class="form-group">
              <label for="demo-role">{t('demo.form.role')}</label>
              <input type="text" id="demo-role" name="role" placeholder={t('demo.form.role.placeholder')} autocomplete="organization-title" />
            </div>
          </div>

          <div class="form-group">
            <label for="demo-gateways">{t('demo.form.gateways')}</label>
            <input type="text" id="demo-gateways" name="gateways" placeholder={t('demo.form.gateways.placeholder')} />
          </div>

          <div class="form-group">
            <label for="demo-message">{t('demo.form.message')}</label>
            <textarea id="demo-message" name="message" rows="4" placeholder={t('demo.form.message.placeholder')}></textarea>
          </div>

          <button type="submit" class="btn btn-primary glow-btn demo-submit">
            {t('demo.form.submit')}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <div id="demo-success" class="demo-message demo-message-success" hidden>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="#10b981" stroke-width="1.5"/><path d="M7 10l2 2 4-4" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {t('demo.form.success')}
          </div>
          <div id="demo-error" class="demo-message demo-message-error" hidden>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" stroke="#ef4444" stroke-width="1.5"/><path d="M7 7l6 6M13 7l-6 6" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round"/></svg>
            {t('demo.form.error')}
          </div>

          <p class="demo-privacy">{t('demo.form.privacy')}</p>
        </form>
      </div>

      <div class="demo-sidebar-col reveal" data-reveal data-reveal-delay="300">
        <div class="demo-sidebar">
          <h3 class="demo-sidebar-title">{t('demo.sidebar.title')}</h3>
          <ul class="demo-sidebar-list">
            {sidebarItems.map((item) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="#10b981" stroke-width="1.5" fill="none"/><path d="M6 8l2 2 3-4" stroke="#10b981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class="demo-sidebar-contact">
            <p>{lang === 'fr' ? 'Vous préférez écrire directement ?' : 'Prefer to email directly?'}</p>
            <a href="mailto:demo@gostoa.dev">demo@gostoa.dev</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('demo-form');
  const successMsg = document.getElementById('demo-success');
  const errorMsg = document.getElementById('demo-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    const submitBtn = form.querySelector('.demo-submit');

    submitBtn.disabled = true;
    submitBtn.style.opacity = '0.6';
    successMsg.hidden = true;
    errorMsg.hidden = true;

    try {
      // Try n8n webhook first (configured via meta tag or env)
      const webhookUrl = document.querySelector('meta[name="demo-webhook"]')?.content;

      if (webhookUrl) {
        const res = await fetch(webhookUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...data, source: 'gostoa.dev/demo', timestamp: new Date().toISOString() }),
        });
        if (res.ok) {
          successMsg.hidden = false;
          form.reset();
          return;
        }
      }

      // Fallback: open mailto with form data
      const subject = encodeURIComponent(`Demo Request from ${data.name} — ${data.company}`);
      const body = encodeURIComponent(
        `Name: ${data.name}\nEmail: ${data.email}\nCompany: ${data.company}\nRole: ${data.role || 'N/A'}\nCurrent Gateway(s): ${data.gateways || 'N/A'}\n\nMessage:\n${data.message || 'N/A'}`
      );
      window.location.href = `mailto:demo@gostoa.dev?subject=${subject}&body=${body}`;
      successMsg.hidden = false;
      form.reset();
    } catch {
      errorMsg.hidden = false;
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = '1';
    }
  });
</script>

<style>
  .demo-section { padding: 120px 0 clamp(4rem, 8vw, 7rem); }
  .demo-grid { display: grid; grid-template-columns: 1fr 380px; gap: 3rem; align-items: start; }
  .demo-heading {
    font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--emerald-400), var(--teal));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
    margin-bottom: 0.75rem;
  }
  .demo-subtitle { font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.6; margin-bottom: 2rem; }

  .demo-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.375rem; }
  .form-group label { font-size: 0.8125rem; font-weight: 600; color: var(--text-secondary); }
  .form-group input, .form-group textarea {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px;
    padding: 0.75rem 1rem; font-size: 0.9375rem; color: var(--text-primary);
    font-family: var(--font-sans); transition: border-color 0.25s;
  }
  .form-group input:focus, .form-group textarea:focus {
    outline: none; border-color: var(--emerald-500);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.1);
  }
  .form-group input::placeholder, .form-group textarea::placeholder { color: var(--text-muted); }
  .form-group textarea { resize: vertical; min-height: 100px; }

  .demo-submit {
    align-self: flex-start; display: flex; align-items: center; gap: 0.5rem;
    font-size: 1rem; font-weight: 600; padding: 0.875rem 2rem; border: none; cursor: pointer;
    border-radius: 12px; transition: opacity 0.25s, transform 0.25s;
  }
  .demo-submit:hover:not(:disabled) { transform: translateY(-1px); }

  .demo-message {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem; padding: 0.75rem 1rem; border-radius: 10px;
  }
  .demo-message-success { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
  .demo-message-error { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }

  .demo-privacy { font-size: 0.75rem; color: var(--text-muted); line-height: 1.5; }

  .demo-sidebar {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px;
    padding: 2rem; position: sticky; top: 100px;
  }
  .demo-sidebar-title { font-size: 1.125rem; font-weight: 700; color: var(--text-primary); margin-bottom: 1.25rem; }
  .demo-sidebar-list { display: flex; flex-direction: column; gap: 0.875rem; }
  .demo-sidebar-list li { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.5; }
  .demo-sidebar-list li svg { flex-shrink: 0; margin-top: 3px; }
  .demo-sidebar-contact {
    margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);
  }
  .demo-sidebar-contact p { font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.25rem; }
  .demo-sidebar-contact a { font-size: 0.9375rem; color: var(--emerald-400); font-weight: 500; }
  .demo-sidebar-contact a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .demo-grid { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .demo-sidebar { position: static; }
  }
</style>
