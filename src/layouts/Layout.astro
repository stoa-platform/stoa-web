---
import SEO from '../components/SEO.astro';
import SecurityMeta from '../components/shared/SecurityMeta.astro';
import StructuredData from '../components/StructuredData.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import ThemeScript from '../components/shared/ThemeScript.astro';
import { getLangFromUrl, useTranslations, getLocalizedHref, getAlternateUrl } from '../i18n/utils';
import '../styles/tokens.css';
import '../styles/base.css';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description, noindex = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const home = getLocalizedHref(lang, '/');
const links = [
  { href: `${home}#produit`, text: t('nav.product') },
  { href: `${home}#architecture`, text: t('nav.architecture') },
  { href: `${home}#offres`, text: t('nav.offers') },
  { href: `${home}#faq`, text: t('nav.questions') },
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <SecurityMeta />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1113" media="(prefers-color-scheme: dark)" />
    <ThemeScript />
    <link rel="preload" href="/fonts/inter/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <SEO title={title} description={description} noindex={noindex} />
    <StructuredData />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t('skip.link')}</a>
    <SiteHeader site="platform" lang={lang} altLangUrl={getAlternateUrl(Astro.url, lang === 'fr' ? 'en' : 'fr')} links={links} />
    <main id="contenu" tabindex="-1"><slot /></main>
    <SiteFooter site="platform" lang={lang} />
    <script src="../scripts/site.js"></script>
  </body>
</html>
